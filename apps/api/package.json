{
  "name": "@khidmat/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "reset": "node --env-file-if-exists=../../.env scripts/reset.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "init": "node --env-file-if-exists=../../.env scripts/init.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@fastify/cors": "11.4.3",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "s3rver": "3.7.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
