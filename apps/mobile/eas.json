{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "fieldtest": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "fieldtest", "EXPO_PUBLIC_APP_VARIANT": "fieldtest", "KHIDMAT_VERSION_CODE": "5" },
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleRelease" }
    },
    "staging": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "staging" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
