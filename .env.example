# Copy to .env for local development. Never commit .env.
APP_NAME=Khidmat
# development | test | staging | production
APP_ENV=development
PORT=3000
DATABASE_URL=postgres://khidmat:khidmat_dev@localhost:5432/khidmat_dev
TEST_DATABASE_URL=postgres://khidmat:khidmat_dev@localhost:5432/khidmat_test

# SMS for OTP. "sandbox" sends nothing and accepts SANDBOX_OTP_CODE; it is refused when APP_ENV=production.
SMS_PROVIDER=sandbox
SANDBOX_OTP_CODE=123456
# Live aggregator settings (owner approval required before filling these in)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Google Maps Platform server key (restricted by IP). Leave empty to use the local place directory only.
MAPS_SERVER_KEY=

# Files (photos, voice notes, provider documents). Local disk in development; private
# S3-compatible bucket (e.g. Cloudflare R2) in production. Downloads use short-lived signed URLs.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
FILE_SIGNING_SECRET=dev-only-file-signing-secret-change-me
SIGNED_URL_TTL_SECONDS=300
MEDIA_RETENTION_DAYS=180

# Background jobs (offer expiry, no-provider, auto-close, media retention). 0 disables the in-process timer.
JOBS_INTERVAL_SECONDS=60
NO_PROVIDER_AFTER_MINUTES=30
# Web app origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Business defaults (all overridable per rule in the database)
DEFAULT_COMMISSION_BPS=800
OFFER_TTL_MINUTES=10
OVERDUE_BALANCE_LIMIT_PAISA=500000
OVERDUE_DAYS=14
SESSION_TTL_DAYS=30
LOG_LEVEL=info
