# Copy to .env for the local test stack (`npm run setup` does this). Never commit .env.
# These defaults are TEST settings: synthetic accounts, the sandbox SMS code and local file storage.
# The API refuses to start with them when APP_ENV is staging or production.
APP_NAME=Khidmat
# development | test | staging | production
APP_ENV=development
PORT=3000
# Matches docker-compose.yml. `npm run db:reset` works only on databases named *_dev, *_test or *_sandbox.
DATABASE_URL=postgres://khidmat:khidmat_dev@localhost:5432/khidmat_dev
TEST_DATABASE_URL=postgres://khidmat:khidmat_dev@localhost:5432/khidmat_test

# ---- Sign-in codes (OTP) ----
# sandbox: no SMS is sent and every number accepts SANDBOX_OTP_CODE. Refused when APP_ENV=production.
# On staging the sandbox code works only for the synthetic numbers in SANDBOX_OTP_ALLOWLIST (required there).
SMS_PROVIDER=sandbox
SANDBOX_OTP_CODE=123456
SANDBOX_OTP_ALLOWLIST=
# aggregator: live SMS. OWNER INPUT, needs approval: https URL, API key and approved sender id from the SMS contract.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TIMEOUT_MS=8000

# Google Maps Platform server key (restricted by IP). OWNER INPUT. Empty = local place directory only, no map pin.
MAPS_SERVER_KEY=

# ---- Files (photos, voice notes, provider documents) ----
# local: files on this laptop under UPLOAD_DIR, served through signed links. Test use only; refused in production.
# s3: private S3-compatible bucket (for example Cloudflare R2). OWNER INPUT, needs approval: bucket, endpoint, keys.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300
MEDIA_RETENTION_DAYS=180

# ---- Signing secrets ----
# Must be replaced with random values (32+ characters) on staging and production: `openssl rand -hex 32`
FILE_SIGNING_SECRET=dev-only-file-signing-secret-change-me
QUOTE_SIGNING_SECRET=dev-only-quote-signing-secret-change-me

# Background jobs (offer expiry, no-provider, auto-close, media retention). 0 disables the in-process timer.
JOBS_INTERVAL_SECONDS=60
NO_PROVIDER_AFTER_MINUTES=30
# Browser origins allowed to call the API directly. Not needed when the web app is served by `npm run serve:web`.
CORS_ORIGINS=http://localhost:5173

# Business defaults (all overridable per rule in the database)
DEFAULT_COMMISSION_BPS=800
OFFER_TTL_MINUTES=10
OVERDUE_BALANCE_LIMIT_PAISA=500000
OVERDUE_DAYS=14
SESSION_TTL_DAYS=30
LOG_LEVEL=info
